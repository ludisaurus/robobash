// Definición de pines para el Motor A
const int pinPWM = 16;  // Pin de velocidad (PWM)
const int pinIN1 = 17;  // Pin de dirección 1
const int pinIN2 = 18;  // Pin de dirección 2
const int pinSTBY = 19; // Pin de habilitación (Standby)

// Configuración de PWM
const int frecuencia = 16000; // 16 kHz para evitar ruido
const int canalPWM = 0;       // Canal LEDC a usar
const int resolucion = 8;     // 8 bits (0-255)

void setup() {
  pinMode(pinIN1, OUTPUT);
  pinMode(pinIN2, OUTPUT);
  pinMode(pinSTBY, OUTPUT);
  
  // Configuración del canal PWM
  ledcAttachChannel(pinPWM, frecuencia, resolucion, canalPWM);
  
  // Activar el driver (Sacarlo del modo Standby)
  digitalWrite(pinSTBY, HIGH);
}

// Función para mover el motor
void moverMotor(int velocidad) {
  if (velocidad > 0) {
    digitalWrite(pinIN1, HIGH);
    digitalWrite(pinIN2, LOW);
    ledcWrite(pinPWM, velocidad);
  } else if (velocidad < 0) {
    digitalWrite(pinIN1, LOW);
    digitalWrite(pinIN2, HIGH);
    ledcWrite(pinPWM, abs(velocidad));
  } else {
    digitalWrite(pinIN1, LOW);
    digitalWrite(pinIN2, LOW);
    ledcWrite(pinPWM, 0);
  }
}

void loop() {
  moverMotor(200); // Gira a velocidad 200 hacia un lado
  delay(2000);
  moverMotor(-200); // Gira a velocidad 200 hacia el otro
  delay(2000);
}
